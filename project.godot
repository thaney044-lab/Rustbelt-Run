config_version=5

[application]
config/name="Rustbelt Run"
config/icon="res://assets/art/panda_icon.svg"
run/main_scene="res://scenes/campaign_menu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]
Campaign="*res://scripts/campaign.gd"

[display]
window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.12, 0.14, 1)
